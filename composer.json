{
  "name": "swolley/laraplate-cms",
  "vendor": "swolley",
  "description": "CMS module contains all the necessary functionalities to build a new content management system.",
  "version": "v1.44.0",
  "keywords": [
    "laravel",
    "laraplate",
    "cms"
  ],
  "authors": [
    {
      "name": "Swolley",
      "email": "myentity@inwind.it"
    }
  ],
  "license": "AGPL-3.0-or-later",
  "type": "laravel-module",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/swolley/license-compliance-checker.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-gd": "*",
    "ext-exif": "*",
    "laravel/framework": "^12.0",
    "php-ffmpeg/php-ffmpeg": "^1.4"
  },
  "suggest": {
    "ext-imagick": "Advanced image processing"
  },
  "scripts": {
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\CMS\\": "app/",
      "Modules\\CMS\\Database\\Factories\\": "database/factories/",
      "Modules\\CMS\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\CMS\\Tests\\Unit\\": "tests/Unit",
      "Modules\\CMS\\Tests\\Feature\\": "tests/Feature"
    },
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
